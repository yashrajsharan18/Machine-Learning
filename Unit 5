    {
      "cell_type": "code",
      "source": [
        "models = {\n",
        "    'AdaBoost': ada,\n",
        "    'Naive Bayes': GaussianNB(),\n",
        "    'Logistic Regression': make_pipeline(StandardScaler(), LogisticRegression(max_iter=2000)),\n",
        "    'Random Forest': RandomForestClassifier(n_estimators=200, random_state=42)}\n",
        "rows = []\n",
        "for name, m in models.items():\n",
        "    m.fit(X_train, y_train); p = m.predict(X_test)\n",
        "    rows.append([name, accuracy_score(y_test,p), precision_score(y_test,p),\n",
        "                 recall_score(y_test,p), f1_score(y_test,p)])\n",
        "pd.DataFrame(rows, columns=['Model','Accuracy','Precision','Recall','F1']).round(4)"
      ],
